     <script>
         var auto_refresh = null;
+
+        // Flow Board column sorting. The table is fully re-rendered on every refresh,
+        // so the chosen sort is kept here and re-applied by drawTable() after each redraw.
+        // Seeded from the Flow Board default-sort globals (site default, or the user's
+        // own User Settings override).
+        var flbSort = {
+            col: <?php echo js_escape(($GLOBALS['ptkr_default_sort'] ?? '') ?: 'appttime'); ?>,
+            dir: <?php echo js_escape((($GLOBALS['ptkr_default_sort_dir'] ?? '') === 'desc') ? 'desc' : 'asc'); ?>
+        };
+
+        // Read a row's sort key for a given column: prefer the cell's normalized
+        // data-sortval, fall back to its visible text.
+        function flbCellVal(row, col) {
+            var cell = row.querySelector('td[data-col="' + col + '"]');
+            if (!cell) {
+                return '';
+            }
+            var v = cell.getAttribute('data-sortval');
+            return (v !== null) ? v : (cell.textContent || '').trim();
+        }
+
+        // Reorder the visible flow board rows by the current flbSort selection and
+        // refresh the header carets. Empty values always sort last.
+        function applyFlbSort() {
+            var tbody = document.querySelector('#flb_table tbody');
+            if (!tbody) {
+                return;
+            }
+            var col = flbSort.col;
+            var dir = flbSort.dir;
+            var numRe = /^-?\d+(\.\d+)?$/;
+            var rows = Array.prototype.slice.call(tbody.getElementsByTagName('tr'));
+            rows.sort(function (a, b) {
+                var av = flbCellVal(a, col);
+                var bv = flbCellVal(b, col);
+                if (av === '' && bv === '') {
+                    return 0;
+                }
+                if (av === '') {
+                    return 1;   // blanks last, regardless of direction
+                }
+                if (bv === '') {
+                    return -1;
+                }
+                var cmp;
+                if (numRe.test(av) && numRe.test(bv)) {
+                    cmp = parseFloat(av) - parseFloat(bv);
+                } else {
+                    cmp = String(av).localeCompare(String(bv), undefined, { numeric: true, sensitivity: 'base' });
+                }
+                return (dir === 'desc') ? -cmp : cmp;
+            });
+            rows.forEach(function (r) {
+                tbody.appendChild(r);
+            });
+            // update header direction indicators
+            $('#flb_table .flb-caret').html('');
+            $('#flb_table td.flb-sortable[data-col="' + col + '"] .flb-caret')
+                .html(dir === 'desc' ? ' ▼' : ' ▲');
+        }
+
         //this can be refined to redact HIPAA material using @media print options.
         window.parent.$("[name='flb']").attr('allowFullscreen', 'true');
         $("[name='kiosk_hide']").show();
